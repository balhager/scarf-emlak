{
  "expo": {
    "name": "Vestiarch",
    "slug": "vestiarch",
    "version": "1.0.0",
    "scheme": "vestiarch",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vestiarch.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.vestiarch.app"
    },
    "plugins": [
      "expo-router",
      "react-native-reanimated",
      ["expo-image-picker", { "photosPermission": "Allow Vestiarch to access your photos to add wardrobe items." }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
